LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Sets the default UI toggle; CLI real mode is selected by --real.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
# Blended USD price per million total tokens. Zero means unknown, not free.
PRICE_PER_MILLION_TOKENS=0
LLM_TIMEOUT_SECONDS=30
MAX_QUESTIONS=8
MAX_SEARCH_CALLS=12
MAX_CANDIDATES=30
MAX_FETCH_PAGES=8
MAX_ROUNDS=2
MAX_LLM_CALLS=10
MAX_TOTAL_TOKENS=100000
# Zero disables the estimated model-cost cap; nonzero requires a price.
# Search-provider fees are separate. Optional Judge has its own review budget.
MAX_COST_USD=0
RESEARCH_TIMEOUT_SECONDS=180
MAX_DOWNLOAD_BYTES=2000000
CACHE_TTL_SECONDS=600
CONTEXT_TOKEN_BUDGET=16000
EVIDENCE_TOKEN_BUDGET=6500
PLAN_MAX_TOKENS=1800
REPORT_MAX_TOKENS=4000
REVIEW_MAX_TOKENS=2400
