LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Leave default for other providers. DeepSeek Flash enables thinking by default;
# disabled avoids spending small structured-output budgets on reasoning.
LLM_THINKING_MODE=default
# Legacy core option. Each submitted service task defaults to mock=true.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
# Blended USD price per million total tokens. Zero means unknown, not free.
PRICE_PER_MILLION_TOKENS=0
LLM_TIMEOUT_SECONDS=30
MAX_QUESTIONS=8
MAX_SEARCH_CALLS=12
MAX_CANDIDATES=30
MAX_FETCH_PAGES=8
MAX_ROUNDS=2
MAX_LLM_CALLS=10
MAX_TOTAL_TOKENS=100000
# Zero disables the estimated model-cost cap; nonzero requires a price.
# Search-provider fees are separate. Optional Judge has its own review budget.
MAX_COST_USD=0
RESEARCH_TIMEOUT_SECONDS=180
MAX_DOWNLOAD_BYTES=2000000
FETCH_CONCURRENCY=3
CACHE_TTL_SECONDS=600
CONTEXT_TOKEN_BUDGET=16000
EVIDENCE_TOKEN_BUDGET=6500
PLAN_MAX_TOKENS=1800
REPORT_MAX_TOKENS=4000
REVIEW_MAX_TOKENS=2400

# MySQL is authoritative; Redis is the task broker.
DATABASE_URL=mysql+pymysql://agentscout:local_demo_only@127.0.0.1:3306/agentscout?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
MAX_TASK_TOKENS=120000
MAX_TASK_SEARCH_CALLS=24
MAX_TASK_ATTEMPTS=3
DISPATCH_MAX_ATTEMPTS=10
DISPATCH_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=90
UI_SECRET=
MYSQL_PASSWORD=local_demo_only
MYSQL_ROOT_PASSWORD=local_root_only
# Explicit approved documentation prefixes; a matching forum remains a forum.
OFFICIAL_SOURCE_PREFIXES=[]
RETRIEVAL_MODE=bm25
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_MAX_TOKENS=16000
EMBEDDING_PROVIDER=local
# Prepare the model explicitly before enabling hybrid retrieval.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
